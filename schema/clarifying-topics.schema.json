{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clarifying-topics.schema.json",
  "title": "Clarifying-question topics",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics"],
  "properties": {
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "applies_when", "questions", "enabled"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "label": { "type": "string", "minLength": 1 },
          "systems": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "applies_when": { "type": "string", "minLength": 1 },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "enabled": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
