{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request-types.schema.json",
  "title": "Request types",
  "type": "object",
  "additionalProperties": false,
  "required": ["types"],
  "properties": {
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "extra_attention", "enabled"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "extra_attention": {
            "type": "array",
            "items": { "$ref": "#/$defs/slug" },
            "uniqueItems": true
          },
          "enabled": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
